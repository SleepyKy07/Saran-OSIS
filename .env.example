# Database PostgreSQL (lokal / Neon / Supabase)
DATABASE_URL="postgresql://user:***@host:5432/kotak_saran_osis"

# Opsional (disarankan bila pakai pooler seperti Neon): koneksi LANGSUNG
# tanpa pooler, dipakai khusus saat menjalankan migrasi (prisma migrate).
# Contoh Neon: sama seperti DATABASE_URL tapi tanpa akhiran "-pooler".
# Bila kosong, migrasi memakai DATABASE_URL.
# DIRECT_URL="postgresql://user:***@host:5432/kotak_saran_osis"

# Rate limiting (disarankan untuk produksi). Buat database Redis gratis di
# https://upstash.com -> Redis -> REST API. Bila kosong, aplikasi tetap jalan
# memakai penghitung in-memory (kurang akurat di serverless/Vercel).
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"

# Rahasia server (wajib, min 32 karakter acak). Generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NIS_HASH_SECRET dipakai sebagai kunci hash satu arah untuk ID akun Google.
NIS_HASH_SECRET="ganti-dengan-64-karakter-heks-acak"
SISWA_SESSION_SECRET="ganti-dengan-64-karakter-heks-acak"
ADMIN_SESSION_SECRET="ganti-dengan-64-karakter-heks-acak"

# Login Google (wajib untuk siswa). Buat di https://console.cloud.google.com/
# APIs & Services > Credentials > Create Credentials > OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# + https://domain-produksi/api/auth/callback/google
GOOGLE_CLIENT_ID="isi-dengan-client-id-google"
GOOGLE_CLIENT_SECRET="isi-dengan-client-secret-google"

# Nama sekolah yang tampil di halaman
NEXT_PUBLIC_SCHOOL_NAME="SMK AL HIKMAH KAlIREJO"

# Logo: taruh file di folder public/ (otomatis dipakai, tanpa setting lain)
# public/logo-sekolah.png (atau .jpg) dan public/logo-osis.png (atau .jpg)

# Akun admin awal untuk `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-setelah-login"
ADMIN_NAME="Admin OSIS"

# Username yang menjadi SUPER admin (satu-satunya yang bisa mengelola akun admin lain).
# Default memakai ADMIN_USERNAME bila tidak diisi. Ubah sesuai kebutuhan, lalu jalankan db:seed / skrip set-super.
SUPER_ADMIN_USERNAME="admin"
